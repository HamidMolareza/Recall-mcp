{
  "Storage": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=app-data/memory.db"
  },
  "Embedding": {
    "Provider": "Ollama",
    "Model": "nomic-embed-text",
    "BaseUrl": "http://localhost:11434",
    "ApiKey": "",
    "Dimensions": 768
  },
  "AI": {
    "Provider": "Simple",
    "Model": "gapgpt-qwen-3.5",
    "BaseUrl": "https://api.gapgpt.app/v1",
    "ApiKey": ""
  },
  "Memory": {
    "DefaultTtlDays": null,
    "MaxEntriesPerNamespace": 10000,
    "StalenessThresholdDays": 90,
    "EnableContradictionDetection": true,
    "EnableDeduplication": true
  },
  "Logging": {
    "LogPath": "app-data/logs",
    "AuditLogFile": "audit-.log",
    "ErrorLogFile": "errors-.log",
    "GeneralLogFile": "app-.log",
    "RollingInterval": "Day",
    "RetainedFileCountLimit": 30,
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Server": {
    "Transport": "stdio"
  }
}
